# Copy to .env (never commit real values)
# ANTHROPIC_API_KEY=sk-ant-...           # optional: enables the Claude planner
# HAZARDLENS_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=auto                      # auto | anthropic | bedrock | rule
# BEDROCK_MODEL_ID=                      # required when LLM_PROVIDER=bedrock
# APPROVER_TOKEN=change-me               # required header for approve/reject when set
# TRACE_BUCKET=                          # S3 bucket for run traces (set by CDK on AWS)
# ALERT_TOPIC_ARN=                       # SNS topic for approved alerts (set by CDK on AWS)
